{
  "name": "CSC Domain Block",
  "version": "1.0",
  "author": "CSC",
  "description": "Domain blocking Chrome Extension.",
  "permissions": [
    "webRequest",
    "<all_urls>",
    "webRequestBlocking"
  ],
  "web_accessible_resources": [
    "url.json",
    "bootstrap.min.css"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": true
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/csc-16.png",
      "32": "images/csc-48.png",
      "48": "images/csc-48.png",
      "128": "images/csc-128.png"
    },
    "default_title": "Domain blocking Chrome Extension."
  },
  "icons": {
    "16": "images/csc-16.png",
    "32": "images/csc-48.png",
    "48": "images/csc-48.png",
    "128": "images/csc-128.png"
  },
  "manifest_version": 2
}
